# ============================================================
#  Telegram AutoComment UserBot — Environment Variables
#  Copy this file, rename it to .env, and fill in your values
# ============================================================

# ---------------------------
# Telegram API Credentials
# Get these from: https://my.telegram.org/apps
# ---------------------------
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# ---------------------------
# Bot Token
# Get this from @BotFather on Telegram
# (Used for the control bot — add/remove comments, start/stop)
# ---------------------------
BOT_TOKEN=your_bot_token_here

# ---------------------------
# Telegram Session String
# Leave blank for now — generated by running: python login.py
# After running login.py, paste the output here
# ---------------------------
TELEGRAM_SESSION=
